# Copy this file to ".env" and fill in your own values.
# NEVER commit your real ".env" file.

# Port the server will listen on (hosting services such as Render set this for you)
PORT=5000

# MongoDB connection string (local MongoDB or MongoDB Atlas)
# Local example:  mongodb://127.0.0.1:27017/task_manager_db
# Atlas example:  mongodb+srv://<username>:<password>@<cluster-url>/task_manager_db?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# Secret key used to sign login tokens. Use a long random value and keep it private.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# How long a login token stays valid (examples: 1h, 1d, 7d)
JWT_EXPIRES_IN=1d

# Address(es) of the React app allowed to call this API (comma-separated)
CLIENT_URL=http://localhost:5173

# "development" shows error details, "production" hides them
NODE_ENV=development
